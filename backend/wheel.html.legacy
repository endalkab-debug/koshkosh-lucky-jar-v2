<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#102f36">
  <title>KoshKosh Lucky Wheel</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    :root {
      color-scheme: dark;
      --teal: #0f5c63;
      --slate: #1c3f4a;
      --orange: #f28c28;
      --gold: #f5c66b;
      --cream: #fff4dc;
      --muted: #a9c2c1;
      --panel: rgba(255,255,255,.075);
      --line: rgba(255,255,255,.13);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: #fff;
      background:
        radial-gradient(circle at 50% 0%, rgba(242,140,40,.22), transparent 34rem),
        linear-gradient(155deg, #102f36 0%, #153f49 48%, #0b252c 100%);
      padding: max(18px, env(safe-area-inset-top)) 16px max(26px, env(safe-area-inset-bottom));
      text-align: center;
    }
    .shell { width: min(100%, 560px); margin: 0 auto; }
    .brand { display:flex; justify-content:center; align-items:center; gap:9px; margin: 3px 0 5px; }
    .brand-mark { width:35px; height:35px; display:grid; place-items:center; border-radius:50%; background:linear-gradient(145deg,#f6c86e,#ef8b26); color:#183b43; font-size:20px; box-shadow:0 0 22px #f28c2845; }
    .brand-name { font-weight:900; letter-spacing:2.1px; font-size:14px; }
    h1 { margin: 9px 0 4px; font-size: clamp(25px, 7vw, 34px); line-height:1.1; letter-spacing:-.8px; }
    .subtitle { margin:0 auto 17px; color:var(--muted); font-size:13px; line-height:1.55; max-width:360px; }
    .round-pill { display:inline-flex; align-items:center; gap:7px; padding:7px 13px; border:1px solid #f2a54b65; border-radius:30px; color:#ffd58c; background:#f28c2818; font-size:12px; font-weight:800; letter-spacing:.5px; }
    
    .wheel-stage { position:relative; width:min(88vw, 430px); aspect-ratio:1; margin:28px auto 14px; filter:drop-shadow(0 17px 24px #0007); }
    canvas { display:block; width:100%; height:100%; }

    /* Pointer + Zooming Magnifier Lens */
    .pointer-assembly {
      position: absolute;
      z-index: 5;
      left: 50%;
      top: -20px;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      pointer-events: none;
    }
    .zoom-lens {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.35), rgba(16, 47, 54, 0.92));
      border: 3px solid var(--gold);
      box-shadow:
        0 6px 18px rgba(0, 0, 0, 0.65),
        inset 0 2px 6px rgba(255, 255, 255, 0.5),
        0 0 14px rgba(245, 198, 107, 0.45);
      display: grid;
      place-items: center;
      font-weight: 950;
      font-size: 15px;
      color: #fff8e9;
      text-shadow: 0 2px 6px rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(4px);
      transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }
    .zoom-lens.locked {
      transform: scale(1.16);
      font-size: 20px;
      border-color: #fff;
      box-shadow:
        0 8px 24px rgba(242, 140, 40, 0.7),
        inset 0 2px 8px rgba(255, 255, 255, 0.75),
        0 0 20px rgba(245, 198, 107, 0.9);
    }
    .pointer-tip {
      width: 0;
      height: 0;
      margin-top: -3px;
      border-left: 13px solid transparent;
      border-right: 13px solid transparent;
      border-top: 22px solid var(--orange);
      filter: drop-shadow(0 3px 3px #0009);
    }

    .status-card { background:var(--panel); border:1px solid var(--line); border-radius:17px; padding:13px 15px; margin: 9px auto 15px; backdrop-filter:blur(10px); }
    .status-title { font-size:14px; font-weight:850; color:#ffe0a5; margin-bottom:4px; }
    .status-detail { font-size:12px; color:var(--muted); line-height:1.5; }
    .winner-number { font-size:34px; line-height:1; font-weight:950; color:#ffd17d; margin:7px 0 3px; text-shadow:0 2px 16px #f28c2855; }
    .results { display:grid; gap:9px; margin-top:13px; text-align:left; }
    .result-card { display:flex; align-items:center; gap:12px; padding:12px 14px; background:var(--panel); border:1px solid var(--line); border-radius:15px; animation:pop .35s ease-out both; }
    .medal { width:38px; height:38px; flex:0 0 38px; display:grid; place-items:center; border-radius:12px; background:#f5c66b1c; font-size:21px; }
    .result-info { min-width:0; flex:1; }
    .result-name { font-weight:850; font-size:13px; }
    .result-prize { color:var(--muted); font-size:11px; margin-top:3px; }
    .result-number { color:#ffd17d; font-size:21px; font-weight:950; }
    .footer { color:#799b9a; font-size:10px; margin:17px 0 0; line-height:1.6; }
    .hidden { display:none !important; }
    @keyframes pop { from { opacity:0; transform:translateY(7px) scale(.985); } to { opacity:1; transform:none; } }
    @media (max-width:380px) {
      .wheel-stage { width:min(90vw, 360px); }
      .status-card { padding:11px 12px; }
      .zoom-lens { width: 46px; height: 46px; font-size: 13px; }
      .zoom-lens.locked { font-size: 17px; }
    }
  </style>
</head>
<body>
  <main class="shell">
    <div class="brand"><div class="brand-mark">✦</div><div class="brand-name">KOSHKOSH LUCKY JAR</div></div>
    <h1>🎡 Lucky Wheel</h1>
    <p class="subtitle">Three prizes. Three dramatic reveals. One lucky round.<br>ሶስት ሽልማቶች፣ ሶስት የዕጣ ውጤቶች!</p>
    <div class="round-pill">ROUND <span id="roundId">—</span></div>

    <div class="wheel-stage">
      <div class="pointer-assembly">
        <div class="zoom-lens" id="zoomLens">READY</div>
        <div class="pointer-tip"></div>
      </div>
      <canvas id="wheel" aria-label="KoshKosh Lucky Wheel"></canvas>
    </div>

    <section class="status-card" aria-live="polite">
      <div class="status-title" id="statusTitle">Waiting for the next draw</div>
      <div class="status-detail" id="statusDetail">The wheel will start automatically when the draw begins.<br>ዕጣው ማውጣት ሲጀምር የዕጣ ማውጫው መሽከርከር ይጀምራል።</div>
      <div class="winner-number hidden" id="winnerNumber"></div>
    </section>

    <section class="results" id="results" aria-live="polite"></section>
    <p class="footer">These Results are Generated and Guaranteed by KoshKosh Lucky Jar Lucky Wheel.<br>ይህ የዕጣ ውጤት በKoshKosh Lucky Jar ሎተሪ ዕጣ ማውጫ መተግበሪያ የተዘጋጀ እና ዋስትና የተሰጠው ነው።</p>
  </main>

  <script>
    (() => {
      const TOTAL = Number({{ total_numbers|default(100)|tojson }});
      const canvas = document.getElementById('wheel');
      const ctx = canvas.getContext('2d');
      const roundEl = document.getElementById('roundId');
      const titleEl = document.getElementById('statusTitle');
      const detailEl = document.getElementById('statusDetail');
      const numberEl = document.getElementById('winnerNumber');
      const resultsEl = document.getElementById('results');
      const zoomLensEl = document.getElementById('zoomLens');
      const tg = window.Telegram && window.Telegram.WebApp;
      if (tg) { tg.ready(); tg.expand(); try { tg.setHeaderColor('#102f36'); tg.setBackgroundColor('#102f36'); } catch (_) {} }

      let rotation = 0;
      let freeFrame = null;
      let isFreeSpinning = false;
      let isStopping = false;
      let lastRevealCount = 0;
      let initialStateLoaded = false;
      let lastActiveRank = 0;
      let renderedResultCount = -1;
      let currentStatus = 'idle';
      const colors = ['#0f5c63', '#1c3f4a', '#f28c28', '#2b7377', '#d99a42', '#24515b'];
      const medals = ['🥇', '🥈', '🥉'];
      const prizeNames = ['First Prize', 'Second Prize', 'Third Prize'];

      function updateZoomLens() {
        if (currentStatus === 'idle') {
          zoomLensEl.textContent = 'READY';
          zoomLensEl.style.background = 'radial-gradient(circle at 30% 30%, rgba(255,255,255,0.32), rgba(15, 92, 99, 0.92))';
          return;
        }
        const arc = (Math.PI * 2) / TOTAL;
        const normalizedRot = ((rotation % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
        const angleAtPointer = ((Math.PI * 2) - normalizedRot) % (Math.PI * 2);
        const index = Math.floor(angleAtPointer / arc) % TOTAL;
        const activeNumber = index + 1;
        const sliceColor = colors[index % colors.length];

        zoomLensEl.textContent = String(activeNumber);
        zoomLensEl.style.background = `radial-gradient(circle at 30% 30%, rgba(255,255,255,0.32), ${sliceColor} 80%)`;
      }

      function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        drawWheel();
      }

      function drawWheel() {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        if (!w || !h) return;
        const cx = w / 2, cy = h / 2;
        const radius = Math.min(w, h) * .465;
        ctx.clearRect(0, 0, w, h);
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(rotation);
        const arc = Math.PI * 2 / TOTAL;
        for (let i = 0; i < TOTAL; i++) {
          const start = -Math.PI / 2 + i * arc;
          const end = start + arc;
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.arc(0, 0, radius, start, end);
          ctx.closePath();
          ctx.fillStyle = colors[i % colors.length];
          ctx.fill();
          ctx.strokeStyle = 'rgba(255,244,220,.5)';
          ctx.lineWidth = TOTAL > 50 ? .5 : 1.25;
          ctx.stroke();

          const mid = start + arc / 2;
          const labelRadius = radius * .82;
          ctx.save();
          ctx.rotate(mid);
          ctx.translate(labelRadius, 0);
          ctx.rotate(Math.PI / 2);
          ctx.fillStyle = '#fff8e9';
          ctx.font = `700 ${Math.max(3.5, Math.min(9.5, 140 / TOTAL))}px system-ui, sans-serif`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(String(i + 1), 0, 0);
          ctx.restore();
        }
        ctx.beginPath();
        ctx.arc(0, 0, radius * .19, 0, Math.PI * 2);
        ctx.fillStyle = '#f6c86e';
        ctx.fill();
        ctx.lineWidth = 4;
        ctx.strokeStyle = '#fff0c9';
        ctx.stroke();
        ctx.fillStyle = '#183b43';
        ctx.font = '900 10px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('KOSH', 0, -5);
        ctx.fillText('KOSH', 0, 7);
        ctx.restore();
        
        ctx.beginPath();
        ctx.arc(cx, cy, radius, 0, Math.PI * 2);
        ctx.lineWidth = 5;
        ctx.strokeStyle = '#f6c86e';
        ctx.stroke();

        updateZoomLens();
      }

      function startFreeSpin() {
        if (isFreeSpinning || isStopping) return;
        isFreeSpinning = true;
        zoomLensEl.classList.remove('locked');
        titleEl.textContent = 'The wheel is spinning… 🎡';
        detailEl.textContent = 'Get ready for the next prize! / ቀጣዩን ሽልማት ይጠብቁ!';
        numberEl.classList.add('hidden');
        const tick = () => {
          if (!isFreeSpinning) return;
          rotation += .24;
          drawWheel();
          freeFrame = requestAnimationFrame(tick);
        };
        freeFrame = requestAnimationFrame(tick);
      }

      function stopAtNumber(number) {
        return new Promise(resolve => {
          isStopping = true;
          isFreeSpinning = false;
          if (freeFrame) cancelAnimationFrame(freeFrame);
          const arc = Math.PI * 2 / TOTAL;
          const centerAngle = -Math.PI / 2 + (Number(number) - .5) * arc;
          const desired = ((-Math.PI / 2 - centerAngle) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
          const current = ((rotation % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
          const delta = (desired - current + Math.PI * 2) % (Math.PI * 2);
          const start = rotation;
          const target = rotation + Math.PI * 2 * 4 + delta;
          const began = performance.now();
          const duration = 1050;
          const frame = now => {
            const p = Math.min(1, (now - began) / duration);
            const eased = 1 - Math.pow(1 - p, 4);
            rotation = start + (target - start) * eased;
            drawWheel();
            if (p < 1) requestAnimationFrame(frame);
            else {
              rotation = target;
              drawWheel();
              zoomLensEl.textContent = String(number);
              zoomLensEl.classList.add('locked');
              isStopping = false;
              resolve();
            }
          };
          requestAnimationFrame(frame);
        });
      }

      function renderResults(results) {
        if (results.length === renderedResultCount) return;
        renderedResultCount = results.length;
        resultsEl.innerHTML = '';
        for (const row of results) {
          const rank = Number(row.prize_rank) - 1;
          const card = document.createElement('div');
          card.className = 'result-card';
          const medal = document.createElement('div');
          medal.className = 'medal';
          medal.textContent = medals[rank] || '🏆';
          const info = document.createElement('div');
          info.className = 'result-info';
          const name = document.createElement('div');
          name.className = 'result-name';
          name.textContent = row.prize_name || prizeNames[rank] || 'Prize';
          const prize = document.createElement('div');
          prize.className = 'result-prize';
          prize.textContent = `${Number(row.amount || 0).toLocaleString()} ETB`;
          const value = document.createElement('div');
          value.className = 'result-number';
          value.textContent = `#${row.number}`;
          info.append(name, prize);
          card.append(medal, info, value);
          resultsEl.appendChild(card);
        }
      }

      async function pollState() {
        try {
          const response = await fetch('/api/wheel/state', { cache: 'no-store' });
          if (!response.ok) throw new Error('State request failed');
          const state = await response.json();
          roundEl.textContent = state.round_id || '—';

          const status = state.status || "idle";
          currentStatus = status;

          // Clean reset when round is idle/waiting for next draw
          if (status === "idle") {
              titleEl.textContent = 'Waiting for the next draw';
              detailEl.textContent = 'The wheel will start automatically when the draw begins.\nዕጣው መውጣት ሲጀምር የዕጣ ማውጫው መሽከርከር ይጀምራል።';
              numberEl.classList.add('hidden');
              zoomLensEl.classList.remove('locked');
              resultsEl.innerHTML = '';
              lastRevealCount = 0;
              renderedResultCount = -1;
              rotation = 0;
              drawWheel();
              initialStateLoaded = true;
              return;
          }

          if (!initialStateLoaded) {
            initialStateLoaded = true;
            renderResults(state.results || []);
            lastRevealCount = Number(state.revealed_count || 0);
            lastActiveRank = Number(state.active_rank || 0);
            if (status === 'spinning' && Number(state.active_rank) > Number(state.revealed_count)) {
              startFreeSpin();
            } else if (lastRevealCount > 0) {
              const latest = state.results[state.results.length - 1];
              titleEl.textContent = status === 'complete' ? 'All three winners revealed!' : 'Latest winner revealed';
              detailEl.textContent = 'The official result is shown below. / ይፋዊ ውጤቱ ከታች ቀርቧል።';
              if (latest) {
                numberEl.textContent = `#${latest.number}`;
                numberEl.classList.remove('hidden');
                const arc = Math.PI * 2 / TOTAL;
                const centerAngle = -Math.PI / 2 + (Number(latest.number) - .5) * arc;
                rotation = ((-Math.PI / 2 - centerAngle) % (Math.PI * 2) + Math.PI * 2) % (Math.PI * 2);
                drawWheel();
                zoomLensEl.textContent = String(latest.number);
                zoomLensEl.classList.add('locked');
              }
            }
            return;
          }

          const revealCount = Number(state.revealed_count || 0);
          if (revealCount > lastRevealCount && !isStopping) {
            const nextResult = (state.results || []).find(row => Number(row.prize_rank) === lastRevealCount + 1);
            if (nextResult) {
              if (!isFreeSpinning) startFreeSpin();
              await stopAtNumber(nextResult.number);
              lastRevealCount = Number(nextResult.prize_rank);
              titleEl.textContent = `${medals[lastRevealCount - 1] || '🏆'} ${nextResult.prize_name} revealed!`;
              detailEl.textContent = `${Number(nextResult.amount).toLocaleString()} ETB prize / የሽልማት መጠን`;
              numberEl.textContent = `#${nextResult.number}`;
              numberEl.classList.remove('hidden');
              renderResults(state.results || []);
            }
          }

          const activeRank = Number(state.active_rank || 0);
          if (status === 'spinning' && activeRank > Number(state.revealed_count || 0) && activeRank !== lastActiveRank && !isStopping) {
            lastActiveRank = activeRank;
            startFreeSpin();
          } else if (status === 'spinning' && activeRank > Number(state.revealed_count || 0) && !isFreeSpinning && !isStopping) {
            startFreeSpin();
          }

          if (status === 'complete' && revealCount >= 3 && !isFreeSpinning && !isStopping) {
            titleEl.textContent = '🏆 All three winners revealed!';
            detailEl.textContent = 'Thank you for playing KoshKosh Lucky Jar. / ከKoshKosh Lucky Jar ጋር ስለተሳተፉ እናመሰግናለን።';
            if (state.results && state.results.length) {
              const latest = state.results[state.results.length - 1];
              numberEl.textContent = `#${latest.number}`;
              numberEl.classList.remove('hidden');
            }
          }
        } catch (_) {
          if (!initialStateLoaded) {
            titleEl.textContent = 'Connecting to the Lucky Wheel…';
            detailEl.textContent = 'Please keep this screen open. / እባክዎ ይህን ገጽ ክፍት ያድርጉ።';
          }
        }
      }

      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      pollState();
      setInterval(pollState, 700);
    })();
  </script>
</body>
</html>