# Shared by bot and API services
BOT_TOKEN=replace_with_telegram_bot_token
HOST_TELEGRAM_ID=replace_with_admin_telegram_numeric_id
DATABASE_URL=postgresql://...
TOTAL_NUMBERS=100
PRICE_PER_NUMBER=100
TRANSACTION_MINUTES=15
DRAW_DELAY_MINUTES=20
SUPPORT_CHANNEL=@KoshKoshSupport
BOT_USERNAME=@KoshKosh_LuckyJar_bot

# API service
TELEGRAM_INITDATA_MAX_AGE=86400
MINIAPP_ALLOWED_ORIGINS=https://your-miniapp-domain.example
PORT=10000

# Frontend build-time variables
VITE_API_BASE_URL=https://your-api-service.onrender.com

# Supabase Storage (API service only; NEVER expose these as VITE_ variables)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_side_service_role_key
SUPABASE_RECEIPTS_BUCKET=payment-receipts
MAX_RECEIPT_BYTES=8388608
